+/// i95 (launcher patch, vendor/patches/rt-vicetay.patch): while the title draws almost
+/// nothing (its account picker and start screens), the picture at `I95_BACKDROP` (a 24- or
+/// 32-bit BMP) is copied over the top 90% of each frame; the bottom strip keeps the title's
+/// button prompts. Off for good once a frame draws the world.
+mod i95_backdrop {
+    use super::*;
+    use std::cell::RefCell;
+    use std::sync::atomic::{AtomicBool, AtomicU64};
+
+    static LAST: AtomicU64 = AtomicU64::new(0);
+    static DONE: AtomicBool = AtomicBool::new(false);
+    const FEW: u64 = 50;
+    const WORLD: u64 = 300;
+
+    /// (width, height, rows top-down as BGRA).
+    fn picture() -> Option<&'static (usize, usize, Vec<[u8; 4]>)> {
+        static PIC: OnceLock<Option<(usize, usize, Vec<[u8; 4]>)>> = OnceLock::new();
+        PIC.get_or_init(|| {
+            let b = std::fs::read(std::env::var_os("I95_BACKDROP")?).ok()?;
+            let u = |i: usize, n: usize| b.get(i..i + n).map(|s| s.iter().rev().fold(0u64, |a, &x| a << 8 | x as u64));
+            let (off, w, h, bpp) = (u(10, 4)? as usize, u(18, 4)? as i32, u(22, 4)? as i32, u(28, 2)? as usize);
+            if b.get(..2)? != b"BM" || w <= 0 || h == 0 || (bpp != 24 && bpp != 32) {
+                return None;
+            }
+            let (w, up, h) = (w as usize, h > 0, h.unsigned_abs() as usize);
+            let stride = (w * bpp / 8).div_ceil(4) * 4;
+            let mut px = Vec::with_capacity(w * h);
+            for y in 0..h {
+                let row = off + stride * if up { h - 1 - y } else { y };
+                for x in 0..w {
+                    let p = b.get(row + x * bpp / 8..row + x * bpp / 8 + 3)?;
+                    px.push([p[0], p[1], p[2], 255]);
+                }
+            }
+            Some((w, h, px))
+        })
+        .as_ref()
+    }
+
+    thread_local! {
+        /// The filled upload buffer for one back-buffer size and format.
+        static READY: RefCell<Option<((u32, u32, i32), ID3D12Resource, D3D12_PLACED_SUBRESOURCE_FOOTPRINT)>> = const { RefCell::new(None) };
+    }
+
+    pub(super) fn draw(
+        device: &ID3D12Device,
+        copy: &super::HostList,
+        list: &ID3D12GraphicsCommandList,
+        back: &ID3D12Resource,
+        (w, h): (u32, u32),
+        format: DXGI_FORMAT,
+    ) {
+        let drawn = crate::draw::drawn();
+        let frame = drawn - LAST.swap(drawn, Ordering::Relaxed);
+        if frame >= WORLD {
+            DONE.store(true, Ordering::Relaxed);
+        }
+        let bgra = match format {
+            DXGI_FORMAT_B8G8R8A8_UNORM => true,
+            DXGI_FORMAT_R8G8B8A8_UNORM => false,
+            _ => return,
+        };
+        if DONE.load(Ordering::Relaxed) || frame >= FEW || w < 16 || h < 16 {
+            return;
+        }
+        let Some((pw, ph, px)) = picture() else { return };
+        READY.with(|ready| {
+            let mut ready = ready.borrow_mut();
+            let key = (w, h, format.0);
+            if ready.as_ref().is_none_or(|(k, ..)| *k != key) {
+                *ready = None;
+                // SAFETY: a live back buffer and device; the buffer is mapped and written in its bounds.
+                unsafe {
+                    let desc = back.GetDesc();
+                    let mut foot = D3D12_PLACED_SUBRESOURCE_FOOTPRINT::default();
+                    let mut total = 0u64;
+                    device.GetCopyableFootprints(&desc, 0, 1, 0, Some(&mut foot), None, None, Some(&mut total));
+                    let heap = D3D12_HEAP_PROPERTIES { Type: D3D12_HEAP_TYPE_UPLOAD, ..Default::default() };
+                    let bd = D3D12_RESOURCE_DESC {
+                        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+                        Width: total,
+                        Height: 1,
+                        DepthOrArraySize: 1,
+                        MipLevels: 1,
+                        SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+                        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+                        ..Default::default()
+                    };
+                    let mut buf: Option<ID3D12Resource> = None;
+                    if device
+                        .CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, None, &mut buf)
+                        .is_err()
+                    {
+                        return;
+                    }
+                    let Some(buf) = buf else { return };
+                    let mut data = std::ptr::null_mut();
+                    if buf.Map(0, None, Some(&mut data)).is_err() {
+                        return;
+                    }
+                    // Cover: fill the frame, cropping the picture's longer side.
+                    let (fw, fh) = (w as f32, h as f32);
+                    let s = (fw / *pw as f32).max(fh / *ph as f32);
+                    let (ox, oy) = ((*pw as f32 * s - fw) / 2.0, (*ph as f32 * s - fh) / 2.0);
+                    let pitch = foot.Footprint.RowPitch as usize;
+                    for y in 0..h as usize {
+                        let sy = (((y as f32 + oy) / s) as usize).min(ph - 1);
+                        let row = (data as *mut u8).add(y * pitch) as *mut [u8; 4];
+                        for x in 0..w as usize {
+                            let sx = (((x as f32 + ox) / s) as usize).min(pw - 1);
+                            let [b, g, r, a] = px[sy * pw + sx];
+                            *row.add(x) = if bgra { [b, g, r, a] } else { [r, g, b, a] };
+                        }
+                    }
+                    buf.Unmap(0, None);
+                    *ready = Some((key, buf, foot));
+                }
+            }
+            let Some((_, buf, foot)) = ready.as_ref() else { return };
+            copy.keep(buf);
+            let top = h * 9 / 10;
+            // SAFETY: an open list; the back buffer is in the copy-destination state here.
+            unsafe {
+                let from = D3D12_TEXTURE_COPY_LOCATION {
+                    pResource: std::mem::transmute_copy(buf),
+                    Type: D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT,
+                    Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 { PlacedFootprint: *foot },
+                };
+                let to = D3D12_TEXTURE_COPY_LOCATION {
+                    pResource: std::mem::transmute_copy(back),
+                    Type: D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX,
+                    Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 { SubresourceIndex: 0 },
+                };
+                let area = D3D12_BOX { left: 0, top: 0, front: 0, right: w, bottom: top, back: 1 };
+                list.CopyTextureRegion(&to, 0, 0, 0, &from, Some(&area));
+            }
+        });
+    }
+}
